BOT_TOKEN=your-telegram-bot-token-here
ADMINS=123456789,987654321
ip=127.0.0.1
GEMINI_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/pti_bot

# Max PTI inspections analyzed at once. Excess submissions queue for a free slot
# instead of overloading CPU/memory/threads/Gemini quota during a burst. (default: 3)
PTI_MAX_CONCURRENCY=3

# Compliance enforcement. false (default) = never mute drivers and send no overdue
# reminders to the group or admins (the loop only lifts leftover restrictions).
# true = mute non-compliant drivers and send reminders. (default: false)
ENFORCEMENT_ENABLED=false

# Local Bot API Server (removes 20 MB file limit — allows up to 2 GB)
# Get TELEGRAM_API_ID and TELEGRAM_API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=your-api-id-here
TELEGRAM_API_HASH=your-api-hash-here
LOCAL_SERVER_URL=http://localhost:8081
