# Local docker-compose override (dev-only volume mounts etc.)
docker-compose.override.yml

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Local tool installs (e.g. a Windows ffmpeg build) — machine-specific binaries
.tools/

# Test/sample inspection media — large binaries that must never land in git
