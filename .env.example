BOT_TOKEN=your-telegram-bot-token-here
ADMINS=123456789,987654321
ip=127.0.0.1
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: multiple Gemini keys for failover. On a 503 "high demand"/429, the bot
# retries the same request on the next key. Comma-separated; takes priority over
# GEMINI_API_KEY when set. e.g. GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=
DATABASE_URL=postgresql://user:password@localhost:5432/pti_bot

# Max PTI inspections analyzed at once. Excess submissions queue for a free slot
# instead of overloading CPU/memory/threads/Gemini quota during a burst. (default: 3)
PTI_MAX_CONCURRENCY=3

# Split one inspection's frames across the configured GEMINI_API_KEYS and analyze
# the chunks in parallel (e.g. 210 frames / 3 keys = 70 each), then merge. Active
# whenever there's >1 key and 2+ images; with a single key it's one whole call.
# (default: true)
PTI_SPLIT_FRAMES=true

# Auto-inspect a registered driver's standalone video without a /check command.
# false = never auto-run a PTI on group videos; every inspection needs an explicit
# /check (in-reply). Buffering, dedup, and /check are unaffected. Hardcoded TEST
# groups always auto-check regardless of this flag. (default: true)
PTI_AUTOCHECK_ENABLED=true

# Overdue reminders. The bot NEVER restricts/mutes a driver, whatever this is set
# to — it only decides whether the hourly loop nudges overdue drivers in the group
# and sends admins a summary. false (default) = the loop does nothing.
ENFORCEMENT_ENABLED=false

# A group is reported as dormant ("inactive") after this many days with no
# message from a human — bot chatter and join/leave events don't count. Display
# only: it never flips is_active and never silences a reminder. (default: 3)
GROUP_INACTIVE_DAYS=3

# Timezone the weekly PTI quota is anchored to (IANA name). The week resets at
# midnight Monday in this zone, DST-aware. (default: America/New_York)
FLEET_TZ=America/New_York

# Web admin panel (Telegram Mini App). The bot serves the panel UI + API on
# PORT (Railway injects it) or WEBAPP_PORT (default 8080). Set WEBAPP_URL to the
# public HTTPS URL of that server (e.g. the Railway service domain) to show the
# "Open Web Panel" button in /admin. Telegram requires HTTPS; leave empty to
# hide the button (the inline panel keeps working either way).
WEBAPP_URL=
WEBAPP_PORT=8080

# Email alerts for the overdue escalation (#9). When a group hits the every-12h
# overdue phase, the bot emails ALERT_EMAIL_TO alongside the group nag. Sent via
# Gmail SMTP; activates only once SMTP_USER + SMTP_PASSWORD are set (else silent
# no-op). Use a dedicated Gmail account: enable 2-Step Verification, then create
# an App Password (Google Account > Security > App passwords) and put the 16-char
# code in SMTP_PASSWORD (spaces are ignored). SMTP_FROM defaults to SMTP_USER.
ALERT_EMAIL_TO=alerts@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-bot-account@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Local Bot API Server (removes 20 MB file limit — allows up to 2 GB)
# Get TELEGRAM_API_ID and TELEGRAM_API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=your-api-id-here
TELEGRAM_API_HASH=your-api-hash-here
LOCAL_SERVER_URL=http://localhost:8081

# Userbot session for member lookup during onboarding. The Bot API cannot list a
# group's members, so the onboarding prompt borrows a *user* session (read-only)
# to build the driver picker; it reuses TELEGRAM_API_ID/TELEGRAM_API_HASH above.
# Leave both blank to disable — onboarding then falls back to "no member list"
# and admins add drivers with /adddriver.
#
# TELEGRAM_SESSION is a Telethon StringSession, and is how the session reaches
# Railway (a .session file does not survive a redeploy) — generate it with
# scripts/tg_session_to_railway.py. TELEGRAM_SESSION_FILE is the local-dev
# alternative: a path to a .session file.
#
# SECURITY: TELEGRAM_SESSION is full access to the account it was made from.
# Use a dedicated account, never a personal one.
TELEGRAM_SESSION=
TELEGRAM_SESSION_FILE=
